; Engine configuration file.
config_version=5

[application]

config/name="Football Dynasty 26"
config/version="0.8.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.039, 0.031, 0.086, 1)
boot_splash/show_image=false

[autoload]

DB="*res://scripts/db.gd"
UI="*res://scripts/ui.gd"
G="*res://scripts/game.gd"

[display]

window/size/viewport_width=1100
window/size/viewport_height=620
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.094, 1)
